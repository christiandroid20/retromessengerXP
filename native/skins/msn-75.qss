/* MSN Messenger 7.5 / Windows XP Luna.
   Native Qt port informed by the MIT-licensed Retro Messenger theme:
   https://github.com/Lisandro46/retroskin-msn-icq-for-wsp
   This is a native widget stylesheet, not a direct CSS copy. */

QWidget {
    color: #172b4d;
    font-family: Tahoma, "Segoe UI", sans-serif;
    font-size: 9pt;
}
QMainWindow, QWidget#messengerWorkspace { background: #0054e3; }
QMenuBar {
    background: #ece9d8;
    color: #000;
    border-bottom: 1px solid #aca899;
    padding: 2px 3px;
    spacing: 1px;
}
QMenuBar::item { padding: 3px 8px; background: transparent; }
QMenuBar::item:selected { color: #fff; background: #316ac5; }
QMenu {
    background: #fff;
    color: #000;
    border: 1px solid #aca899;
    padding: 3px;
}
QMenu::item { padding: 4px 26px 4px 22px; }
QMenu::item:selected { color: #fff; background: #316ac5; }

QLabel#applicationIdentity {
    color: #fff;
    font-weight: bold;
    padding: 3px 7px;
    background: #0759d7;
    border: 1px solid #1648a0;
}
QComboBox#skinSelector {
    color: #172b4d;
    background: #fff;
    border: 1px solid #7f9db9;
    padding: 3px 6px;
}
QFrame#msnContactWindow, QFrame#msnConversationWindow {
    background: #fff;
    border: 1px solid #6d8fd2;
    border-radius: 4px;
}
QFrame#msnProfilePanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f8fbff, stop:1 #d6e5f8);
    border: 1px solid #a6bad8;
    border-radius: 3px;
}
QLabel#msnDisplayName { color: #173e78; font-weight: bold; }
QComboBox#accountSelector {
    background: #fff;
    color: #000;
    border: 1px solid #7f9db9;
    padding: 2px 4px;
}
QLabel#msnPresence { color: #6b6b6b; font-size: 8pt; font-weight: bold; }
QLabel#msnPersonalMessage { color: #647894; font-size: 8pt; }
QLabel#msnContactHeading {
    color: #174a91;
    font-weight: bold;
    padding: 4px 2px 2px;
    border-bottom: 1px solid #c7d6eb;
}
QLabel#msnGroupHeading {
    color: #345b8d;
    font-weight: bold;
    font-size: 8pt;
    padding: 3px 2px;
    background: #edf3fb;
}
QListWidget#msnContactList {
    background: #fff;
    color: #000;
    border: 1px solid #d4deed;
    selection-background-color: #c9dcf6;
    selection-color: #000;
    outline: none;
}
QLabel#msnEmptyState {
    color: #71829c;
    padding: 7px;
    background: #fff;
}
QPushButton#msnAddContact, QPushButton#msnToolButton, QPushButton#msnSendButton {
    color: #183d70;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fff, stop:0.5 #f2f6fc, stop:1 #d4e2f6);
    border: 1px solid #8aa9d6;
    border-radius: 3px;
    padding: 3px 8px;
}
QPushButton#msnAddContact:disabled, QPushButton#msnToolButton:disabled,
QPushButton#msnSendButton:disabled {
    color: #8996a8;
    background: #e8edf5;
}
QFrame#msnConversationHeader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f4f8fe, stop:1 #d8e6f8);
    border: 1px solid #a6bad8;
    border-radius: 3px;
}
QLabel#msnConversationTitle { color: #174a91; font-weight: bold; }
QLabel#msnConversationPresence { color: #6b6b6b; font-size: 8pt; }
QLabel#msnTransportState { color: #71829c; font-size: 8pt; padding: 2px 5px; }
QFrame#msnMessageHistory {
    background: #fff;
    border: 1px solid #a6bad8;
}
QLabel#msnHistoryEmpty { color: #71829c; padding: 12px; }
QPlainTextEdit#msnMessageComposer {
    background: #fff;
    color: #000;
    border: 1px solid #7f9db9;
    selection-background-color: #316ac5;
}
QPlainTextEdit#msnMessageComposer:disabled {
    color: #8996a8;
    background: #f5f7fa;
}
QLabel#storageState { color: #eaf2ff; font-size: 8pt; }
